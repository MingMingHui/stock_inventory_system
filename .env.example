# Copy to .env.local for local development. Never commit real values.

# --- Browser (Vite) ------------------------------------------------------------
# Public values: they are embedded in the built JavaScript. Security comes from
# Row Level Security in the database, not from hiding these.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Python utilities only (NEVER prefix with VITE_, never put in the frontend) --
# Direct / session-pooler connection string from Supabase > Project Settings > Database.
# Used by python/scripts/import_excel.py, validate_import.py and manage_users.py.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# Local database tests (python/tests): a PostgreSQL server where databases can be created.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# The service-role key is not used anywhere in this project. Do not add it here.
